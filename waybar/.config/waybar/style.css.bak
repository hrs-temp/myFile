* {
    border: none;
    border-radius: 10px;
    font-family: "JetbrainsMono Nerd Font";
    font-size: 12px;
    min-height: 8px;
}

window#waybar {
    background: transparent;
}

window#waybar.hidden {
    opacity: 0.2;
}

#window {
    margin-top: 6px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 10px;
    transition: none;
    color: transparent;
    background: transparent;
}

#workspaces {
    margin-top: 6px;
    margin-left: 12px;
    background: #161320;
    border-radius: 10px;
}

#workspaces button {
    color: #B5E8E0;
    font-size: 16px;
}

#workspaces button.active {
    color: #ABE9B3;
    border-top: 2px solid #ABE9B3;
    border-bottom: 2px solid #ABE9B3;
}

#network {
    margin-top: 6px;
    margin-left: 8px;
    padding-left: 10px;
    padding-right: 10px;
    margin-bottom: 0px;
    border-radius: 10px;
    transition: none;
    color: #161320;
    background: #bd93f9;
}

/* --- BLUETOOTH --- */
#bluetooth {
    margin-top: 6px;
    margin-left: 8px;
    padding-left: 10px;
    padding-right: 10px;
    margin-bottom: 0px;
    border-radius: 10px;
    transition: none;
    color: #161320;
    background: #89b4fa;
}

#bluetooth.connected {
    background-color: #89b4fa;
    color: #11111b;
    border-radius: 20px;
}

#bluetooth.on {
    background-color: #313244;
    color: #89b4fa;
    border-radius: 20px;
}

#bluetooth.off {
    background-color: transparent;
    color: #585b70;
}

#bluetooth.discoverable {
    background-color: #f9e2af;
    color: #11111b;
    border-radius: 20px;
}

/* -----------------------------------------------------------------------------
 * Audio Group & Modules
 * -------------------------------------------------------------------------- */

/* Style the Group container to handle spacing/margins */
#group-audio {
    margin-top: 6px;
    margin-left: 8px;
    padding-left: 0px;
    padding-right: 0px;
    margin-bottom: 0px;
    transition: all 0.3s ease-in-out;
}

/* 1. Style the Icon (Restores your Original Look) */
#pulseaudio {
    background: #FAE3B0;        /* Original Yellow Color */
    color: #1A1826;             /* Dark Text */
    border-radius: 10px;
    padding-left: 10px;
    padding-right: 10px;
    margin-right: 5px;          /* Spacing between icon and slider */
}

/* 2. Style the Slider (Matches the Icon) */
#pulseaudio-slider trough {
    min-height: 10px;
    min-width: 80px;
    border-radius: 10px;
    background-color: #FAE3B0;  /* Match the Yellow Background */
    margin-right: 10px;
}

#pulseaudio-slider highlight {
    min-width: 10px;
    border-radius: 10px;
    background-color: #1A1826;  /* Dark fill color */
}

/* -----------------------------------------------------------------------------
 * Backlight Group & Modules
 * -------------------------------------------------------------------------- */

#group-brightness {
    margin-top: 6px;
    margin-left: 8px;
    padding-left: 0px;
    padding-right: 0px;
    margin-bottom: 0px;
    transition: all 0.3s ease-in-out;
}

/* 1. Style the Icon (Restores your Original Look) */
#backlight {
    background: #F8BD96;        /* Original Peach Color */
    color: #161320;             /* Dark Text */
    border-radius: 10px;
    padding-left: 10px;
    padding-right: 10px;
    margin-right: 5px;
}

/* 2. Style the Slider (Matches the Icon) */
#backlight-slider trough {
    min-height: 10px;
    min-width: 80px;
    border-radius: 10px;
    background-color: #F8BD96;  /* Match the Peach Background */
    margin-right: 10px;
}

#backlight-slider highlight {
    min-width: 10px;
    border-radius: 10px;
    background-color: #161320;  /* Dark fill color */
}

#pulseaudio {
    background: transparent;
    margin-top: 0px;
    margin-bottom: 0px;
    margin-left: 0px;
    padding-left: 0px;
    padding-right: 5px; 
}

/* Slider Styling */
#pulseaudio-slider slider {
    min-height: 10px;
    min-width: 10px;
    opacity: 0;
    background-image: none;
    border: none;
    box-shadow: none;
}

#pulseaudio-slider trough {
    min-height: 5px;
    min-width: 60px;
    border-radius: 5px;
    background-color: rgba(0,0,0,0.1); /* Subtle shadow track */
    margin-top: 0px;
    margin-bottom: 0px;
    margin-left: 10px;
}

#pulseaudio-slider highlight {
    min-width: 10px;
    border-radius: 5px;
    background-color: #1A1826; /* Matches text color */
}

/* --- BACKLIGHT GROUP (Original Color: #F8BD96) --- */
#group-brightness {
    margin-top: 6px;
    margin-left: 8px;
    padding-left: 10px;
    padding-right: 10px;
    margin-bottom: 0px;
    border-radius: 10px;
    transition: all 0.3s ease-in-out; 
    
    /* RESTORED ORIGINAL COLORS */
    color: #161320;
    background: #F8BD96; 
}

#backlight {
    background: transparent;
    margin-top: 0px;
    margin-bottom: 0px;
    margin-left: 0px;
    padding-left: 0px;
    padding-right: 5px; 
}

/* Slider Styling */
#backlight-slider slider {
    min-height: 10px;
    min-width: 10px;
    opacity: 0;
    background-image: none;
    border: none;
    box-shadow: none;
}

#backlight-slider trough {
    min-height: 5px;
    min-width: 60px;
    border-radius: 5px;
    background-color: rgba(0,0,0,0.1); /* Subtle shadow track */
    margin-left: 10px;
}

#backlight-slider highlight {
    min-width: 10px;
    border-radius: 5px;
    background-color: #161320; /* Matches text color */
}


/* --- OTHER MODULES --- */

#battery {
    margin-top: 6px;
    margin-left: 8px;
    padding-left: 10px;
    padding-right: 10px;
    margin-bottom: 0px;
    border-radius: 10px;
    transition: none;
    color: #161320;
    background: #B5E8E0;
}

#battery.charging, #battery.plugged {
    color: #161320;
    background-color: #B5E8E0;
}

#battery.critical:not(.charging) {
    background-color: #B5E8E0;
    color: #161320;
    animation-name: blink;
    animation-duration: 0.5s;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    animation-direction: alternate;
}

@keyframes blink {
    to {
        background-color: #BF616A;
        color: #B5E8E0;
    }
}

#clock {
    margin-top: 6px;
    margin-left: 8px;
    padding-left: 10px;
